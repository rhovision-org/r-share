// BookingFactory: resolve the booking instance factory, spawn one instance, and keep a
// bookingId -> instance URI index for the listing confirm gate.
// Placeholders: __ROOT_URI__.
new
  BookingFactory, bookingIndex,
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, c, ack,
  resolveComponent
in {
contract resolveComponent(@key, ret) = {
  new rCh, Root, kCh in {
    rl!(`__ROOT_URI__`, *rCh) |
    for (Root <- rCh) {
      Root!("resolve", key, 1, *kCh) |
      for (@r <- kCh) {
        match r {
          (true, uri, _) => {
            new cCh in {
              rl!(uri, *cCh) |
              for (C <- cCh) { ret!((true, *C)) }
            }
          }
          _ => { ret!((false, "unavailable", key)) }
        }
      }
    }
  }
} |

  bookingIndex!({}) |

  contract BookingFactory(@"create", dId, @data, releaseToken,
                           @bondUri, settleToken, ret) = {
    new fCh in {
      resolveComponent!("component:booking-instance-factory", *fCh) |
      for (@f <- fCh) {
        match f {
          (true, InstanceFactory) => {
            new bCh in {
              @InstanceFactory!("spawn", *dId, data, *releaseToken,
                                bondUri, *settleToken, *bCh) |
              for (@b <- bCh) {
                match b {
                  (true, uri) => {
                    for (@idx <- bookingIndex) {
                      bookingIndex!(idx.set(data.get("bookingId"), uri)) |
                      ret!((true, uri))
                    }
                  }
                  _ => { ret!(b) }
                }
              }
            }
          }
          _ => { ret!((false, "instance factory")) }
        }
      }
    }
  } |

  contract BookingFactory(@"verify", @bookingId, @unitSlots,
                          releaseToken, ret) = {
    for (@idx <<- bookingIndex) {
      match idx.get(bookingId) {
        Nil => { ret!((false, "booking")) }
        uri => {
          new bCh, vCh in {
            rl!(uri, *bCh) |
            for (BookingContract <- bCh) {
              BookingContract!("verifyHold", bookingId, unitSlots,
                               *releaseToken, *vCh) |
              for (@v <- vCh) { ret!(v) }
            }
          }
        }
      }
    }
  } |

  rl!(`__ROOT_URI__`, *rootCh) |
  for (Root <- rootCh) {
    rs!(bundle+{*BookingFactory}, *c) |
    for (@uri <- c) {
      Root!("register", "component:booking-factory", uri, 1,
            "booking", *deployerId, *ack) |
      for (@r <- ack) {
        match r {
          (true, Nil) => { deployId!([uri]) }
          _ => { 1/0 }
        }
      }
    }
  }
}
