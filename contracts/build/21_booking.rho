// BookingFactory: delegates instance creation to BookingContractFactory.
// Placeholders: __ROOT_URI__.
new
  BookingFactory,
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, c, ack
in {
  contract bookingResolve(@key, ret) = {
    new rCh, Root, kCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", key, 1, *kCh) |
        for (@r <- kCh) {
          match r {
            (true, uri, _) => {
              new cCh in {
                rl!(uri, *cCh) |
                for (C <- cCh) { ret!((true, C)) }
              }
            }
            _ => { ret!((false, "unavailable", key)) }
          }
        }
      }
    }
  } |

  contract BookingFactory(@"create", dId, @data, escrowPurse,
                          releaseToken, brand, ret) = {
    new fCh in {
      bookingResolve!("component:booking-contract-factory", *fCh) |
      for (@f <- fCh) {
        match f {
          (true, Factory) => {
            new cCh in {
              @Factory!("create", *dId, data, *escrowPurse,
                        *releaseToken, *brand, *cCh) |
              for (@r <- cCh) { ret!(r) }
            }
          }
          _ => { ret!((false, "booking factory unavailable")) }
        }
      }
    }
  } |

  rl!(`__ROOT_URI__`, *rootCh) |
  for (Root <- rootCh) {
    rs!(bundle+{*BookingFactory}, *c) |
    for (@uri <- c) {
      Root!("register", "component:booking-factory", uri, 1,
            "booking", *deployerId, *ack) |
      for (@r <- ack) { deployId!([uri]) }
    }
  }
}
