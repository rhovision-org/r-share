// GuestLedgerFactory + GuestLedger. The ledger state cell is passed explicitly to the
// flow helpers, so the helpers stay shallow and no capability is captured in a bundle.
// Placeholders: __ROOT_URI__.
new
  GuestLedgerFactory,
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, c, ack,
  GuestLedgerBook, GuestLedgerDrop, GuestLedgerFinish, GuestLedgerGate, GuestLedgerPay, GuestLedgerReserve, GuestLedgerSpawn, authIsOwner, authOwner, bookingBond, ledgerAdmin, ledgerBookingFactory, ledgerConfirmUnits, ledgerHoldUnits, ledgerMax, ledgerMin, ledgerNow, ledgerPayments, ledgerProviderActive, ledgerReleaseUnits, ledgerResolve, ledgerScanUnits, ledgerSlotScan, ledgerUnitCheck
in {
// Deployer identity helpers. r-cash owns accounts; r-share only derives the owner id.

contract authOwner(dId, ret) = {
  new dops(`rho:rchain:deployerId:ops`), rev(`rho:rev:address`), pkCh, addrCh in {
    dops!("pubKeyBytes", *dId, *pkCh) |
    for (@pk <- pkCh) {
      rev!("fromPublicKey", pk, *addrCh) |
      for (@addr <- addrCh) { ret!((true, addr)) }
    }
  }
} |

contract authIsOwner(dId, @ownerId, ret) = {
  new c in {
    authOwner!(*dId, *c) |
    for (@r <- c) {
      match r {
        (true, addr) => {
          if (addr == ownerId) { ret!((true, Nil)) }
          else { ret!((false, "not owner")) }
        }
        _ => { ret!((false, "not owner")) }
      }
    }
  }
} |

  // ---- stateless resolution and scan helpers ------------------------------------------

  contract ledgerResolve(@key, ret) = {
    new rCh, Root, kCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", key, 1, *kCh) |
        for (@r <- kCh) {
          match r {
            (true, uri, _) => {
              new cCh in {
                rl!(uri, *cCh) |
                for (C <- cCh) { ret!((true, *C)) }
              }
            }
            _ => { ret!((false, "unavailable", key)) }
          }
        }
      }
    }
  } |
  contract ledgerNow(ret) = {
    new cCh in {
      ledgerResolve!("component:clock", *cCh) |
      for (@r <- cCh) {
        match r { (true, Clock) => { @Clock!("now", *ret) } _ => { ret!(r) } }
      }
    }
  } |
  contract ledgerPayments(ret) = { ledgerResolve!("component:payments", *ret) } |
  contract ledgerBookingFactory(ret) = { ledgerResolve!("component:booking-factory", *ret) } |
  contract ledgerAdmin(ret) = { ledgerResolve!("component:admin", *ret) } |
  contract ledgerProviderActive(@providerUri, ret) = {
    if (providerUri == Nil) {
      ret!((true, true))
    } else {
      new cCh in {
        rl!(providerUri, *cCh) |
        for (ProviderContract <- cCh) {
          ProviderContract!("isActive", *ret)
        }
      }
    }
  } |
  contract GuestLedgerGate(ret) = {
    new aCh, pCh in {
      ledgerAdmin!(*aCh) |
      for (@a <- aCh) {
        match a {
          (true, ShareAdmin) => {
            @ShareAdmin!("isPaused", *pCh) |
            for (@p <- pCh) {
              match p {
                (true, true) => { ret!((false, "paused")) }
                (true, false) => { ret!((true, Nil)) }
                _ => { ret!((false, "paused")) }
              }
            }
          }
          _ => { ret!((false, "paused")) }
        }
      }
    }
  } |
  contract bookingBond(@escrowPurse, @brand, @assetId, @expected, settleToken, ret) = {
    new fCh in {
      ledgerResolve!("component:bond-factory", *fCh) |
      for (@f <- fCh) {
        match f {
          (true, BondFactory) => {
            @BondFactory!("create", escrowPurse, brand, assetId, expected,
                          *settleToken, *ret)
          }
          _ => { ret!((false, "bond factory unavailable")) }
        }
      }
    }
  } |

  contract ledgerMin(@a, @b, ret) = { if (a < b) { ret!(a) } else { ret!(b) } } |
  contract ledgerMax(@a, @b, ret) = { if (a > b) { ret!(a) } else { ret!(b) } } |

  contract ledgerSlotScan(@ids, @j, @specMap, @stateMap, @now,
                          @maxLead, @maxSlot, @count, @minStart, @maxEnd, ret) = {
    if (j >= ids.length()) {
      ret!((true, {"count": count, "minStart": minStart, "maxEnd": maxEnd}))
    } else {
      match ids.nth(j) {
        slotId => {
          match specMap.get(slotId) {
            Nil => { ret!((false, "unknown slot")) }
            spec => {
              match stateMap.get(slotId) {
                Nil => { ret!((false, "unknown slot")) }
                state => {
                  match spec.get("startHeight") {
                    Nil => { ret!((false, "schedule")) }
                    startHeight => {
                      match spec.get("endHeight") {
                        Nil => { ret!((false, "schedule")) }
                        endHeight => {
                          if (startHeight >= endHeight) {
                            ret!((false, "schedule"))
                          } else {
                            if (startHeight <= now) {
                              ret!((false, "schedule"))
                            } else {
                              if (startHeight > now + maxLead) {
                                ret!((false, "lead"))
                              } else {
                                if (endHeight - startHeight > maxSlot) {
                                  ret!((false, "duration"))
                                } else {
                                  match state {
                                    ["free", gen] => {
                                      new mnCh, mxCh in {
                                        ledgerMin!(minStart, startHeight, *mnCh) |
                                        ledgerMax!(maxEnd, endHeight, *mxCh) |
                                        for (@mn <- mnCh; @mx <- mxCh) {
                                          ledgerSlotScan!(ids, j + 1, specMap, stateMap,
                                                          now, maxLead, maxSlot,
                                                          count + 1, mn, mx, *ret)
                                        }
                                      }
                                    }
                                    ["held", bId, until] => {
                                      if (now >= until) {
                                        new mnCh, mxCh in {
                                          ledgerMin!(minStart, startHeight, *mnCh) |
                                          ledgerMax!(maxEnd, endHeight, *mxCh) |
                                          for (@mn <- mnCh; @mx <- mxCh) {
                                            ledgerSlotScan!(ids, j + 1, specMap, stateMap,
                                                            now, maxLead, maxSlot,
                                                            count + 1, mn, mx, *ret)
                                          }
                                        }
                                      } else {
                                        ret!((false, "slot held", slotId, until))
                                      }
                                    }
                                    _ => { ret!((false, "slot held", slotId)) }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract ledgerUnitCheck(@unitUri, @listingId, @slotIds, @now,
                           @maxLead, @maxSlot, ret) = {
    new cCh in {
      rl!(unitUri, *cCh) |
      for (Unit <- cCh) {
        new iCh in {
          Unit!("info", *iCh) |
          for (@i <- iCh) {
            match i {
              (true, unit) => {
                if (unit.get("listingId") != listingId) {
                  ret!((false, "unit listing"))
                } else {
                  new sCh, pCh in {
                    Unit!("schedule", slotIds, *sCh) |
                    Unit!("probe", slotIds, *pCh) |
                    for (@ss <- sCh; @ps <- pCh) {
                      match ss {
                        (true, specMap) => {
                          match ps {
                            (true, stateMap) => {
                              new scanCh in {
                                ledgerSlotScan!(slotIds, 0, specMap, stateMap,
                                                now, maxLead, maxSlot,
                                                0, now + maxLead + 1, 0, *scanCh) |
                                for (@part <- scanCh) {
                                  match part {
                                    (true, summary) => {
                                      match unit.get("pricePerSlot") {
                                        Nil => { ret!((false, "price")) }
                                        price => {
                                          ret!((true, summary.set(
                                            "rent", price * summary.get("count"))))
                                        }
                                      }
                                    }
                                    _ => { ret!(part) }
                                  }
                                }
                              }
                            }
                            _ => { ret!(ps) }
                          }
                        }
                        _ => { ret!(ss) }
                      }
                    }
                  }
                }
              }
              _ => { ret!(i) }
            }
          }
        }
      }
    }
  } |

  contract ledgerScanUnits(@unitSlots, @i, @listingId, @now, @maxLead,
                           @maxSlot, @count, @minStart, @maxEnd, @rent, ret) = {
    if (i >= unitSlots.length()) {
      ret!((true, {"count": count, "minStart": minStart, "maxEnd": maxEnd,
                   "rent": rent}))
    } else {
      match unitSlots.nth(i) {
        us => {
          new cCh in {
            ledgerUnitCheck!(us.get("unitUri"), listingId, us.get("slots"),
                             now, maxLead, maxSlot, *cCh) |
            for (@r <- cCh) {
              match r {
                (true, part) => {
                  new mnCh, mxCh in {
                    ledgerMin!(minStart, part.get("minStart"), *mnCh) |
                    ledgerMax!(maxEnd, part.get("maxEnd"), *mxCh) |
                    for (@mn <- mnCh; @mx <- mxCh) {
                      ledgerScanUnits!(unitSlots, i + 1, listingId, now, maxLead,
                                       maxSlot, count + part.get("count"),
                                       mn, mx, rent + part.get("rent"), *ret)
                    }
                  }
                }
                _ => { ret!(r) }
              }
            }
          }
        }
      }
    }
  } |

  contract ledgerHoldUnits(@unitSlots, @i, @bookingId, @until,
                           releaseToken, ret) = {
    new fCh in {
      ledgerResolve!("component:unit-factory", *fCh) |
      for (@f <- fCh) {
        match f {
          (true, UnitFactory) => {
            @UnitFactory!("holdAll", unitSlots, bookingId, until,
                          *releaseToken, *ret)
          }
          _ => { ret!(f) }
        }
      }
    }
  } |

  contract ledgerReleaseUnits(@unitSlots, @i, releaseToken, ret) = {
    new fCh in {
      ledgerResolve!("component:unit-factory", *fCh) |
      for (@f <- fCh) {
        match f {
          (true, UnitFactory) => {
            @UnitFactory!("releaseAll", unitSlots, *releaseToken, *ret)
          }
          _ => { ret!(f) }
        }
      }
    }
  } |

  contract ledgerConfirmUnits(@unitSlots, @i, releaseToken, ret) = {
    new fCh in {
      ledgerResolve!("component:unit-factory", *fCh) |
      for (@f <- fCh) {
        match f {
          (true, UnitFactory) => {
            @UnitFactory!("confirmAll", unitSlots, *releaseToken, *ret)
          }
          _ => { ret!(f) }
        }
      }
    }
  } |

  // ---- state helpers take the ledger cell explicitly ----------------------------------

  contract GuestLedgerReserve(ledgerState, @opId, done) = {
    for (@st <- ledgerState) {
      match st.get("ops").get(opId) {
        Nil => {
          ledgerState!(st.set("ops", st.get("ops").set(opId, {"pending": true}))) |
          done!((true, Nil))
        }
        entry => {
          ledgerState!(st) |
          if (entry.get("pending") == true) {
            done!((false, "pending"))
          } else {
            done!((true, entry))
          }
        }
      }
    }
  } |
  contract GuestLedgerDrop(ledgerState, @opId) = {
    for (@st <- ledgerState) {
      ledgerState!(st.set("ops", st.get("ops").delete(opId)))
    }
  } |
  contract GuestLedgerFinish(ledgerState, @opId, @result) = {
    for (@st <- ledgerState) {
      ledgerState!(st.set("ops", st.get("ops").set(opId, result)))
    }
  } |

  contract GuestLedgerBook(ledgerState, dId, @guestId, @listing,
                           @listingUri, @unitSlots, @opId, ret) = {
    new pvCh in {
      ledgerProviderActive!(listing.get("providerUri"), *pvCh) |
      for (@pv <- pvCh) {
        match pv {
          (true, true) => {
    new tCh in {
      ledgerNow!(*tCh) |
      for (@n <- tCh) {
        match n {
          (true, now) => {
            new scanCh in {
              ledgerScanUnits!(unitSlots, 0, listing.get("listingId"), now,
                               listing.get("terms").get("maxLeadBlocks"),
                               listing.get("terms").get("maxSlotBlocks"),
                               0, now + listing.get("terms").get("maxLeadBlocks") + 1,
                               0, 0, *scanCh) |
              for (@scan <- scanCh) {
                match scan {
                  (true, summary) => {
                    if (summary.get("count") < listing.get("terms").get("minSlots")
                        || summary.get("count") > listing.get("terms").get("maxSlots")) {
                      GuestLedgerDrop!(*ledgerState, opId) |
                      ret!((false, "slots"))
                    } else {
                      if (unitSlots.length() > listing.get("terms").get("maxUnits")) {
                        GuestLedgerDrop!(*ledgerState, opId) |
                        ret!((false, "units"))
                      } else {
                        new bIdCh, untilCh, releaseToken in {
                          bIdCh!(guestId ++ ":" ++ opId) |
                          untilCh!(now + listing.get("terms").get("holdBlocks")) |
                          for (@bId <- bIdCh; @untilHeight <- untilCh) {
                            new heldCh in {
                              ledgerHoldUnits!(unitSlots, 0, bId, untilHeight,
                                               *releaseToken, *heldCh) |
                              for (@held <- heldCh) {
                                match held {
                                  (true, Nil) => {
                                    GuestLedgerPay!(
                                      *ledgerState, *dId, guestId, listing,
                                      listingUri, unitSlots, opId, bId,
                                      untilHeight, summary.get("count"),
                                      summary.get("rent"),
                                      summary.get("minStart"), summary.get("maxEnd"),
                                      *releaseToken, *ret)
                                  }
                                  _ => {
                                    GuestLedgerDrop!(*ledgerState, opId) |
                                    ret!(held)
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                  _ => {
                    GuestLedgerDrop!(*ledgerState, opId) |
                    ret!(scan)
                  }
                }
              }
            }
          }
          _ => {
            GuestLedgerDrop!(*ledgerState, opId) |
            ret!(n)
          }
        }
      }
    }
          }
          (true, false) => {
            GuestLedgerDrop!(*ledgerState, opId) |
            ret!((false, "provider paused"))
          }
          _ => {
            GuestLedgerDrop!(*ledgerState, opId) |
            ret!(pv)
          }
        }
      }
    }
  } |

  contract GuestLedgerPay(ledgerState, dId, @guestId, @listing, @listingUri,
                          @unitSlots, @opId, @bookingId, @untilHeight,
                          @slotCount, @rent, @checkInHeight, @checkOutHeight,
                          releaseToken, ret) = {
    new pCh in {
      ledgerPayments!(*pCh) |
      for (@p <- pCh) {
        match p {
          (true, Payments) => {
            new iCh in {
              @Payments!("issuer", listing.get("terms").get("assetId"), *iCh) |
              for (@i <- iCh) {
                match i {
                  (true, brand, issuer) => {
                    new aCh in {
                      @Payments!("ensureAccount", *dId, *aCh) |
                      for (@a <- aCh) {
                        match a {
                          (true, account, ownerId) => {
                            if (ownerId != guestId) {
                              1/0
                            } else {
                              new purseCh in {
                                @issuer!("makeEmptyPurse", *purseCh) |
                                for (@pu <- purseCh) {
                                  match pu {
                                    (true, purse) => {
                                      new totalCh in {
                                        totalCh!(
                                          rent + listing.get("terms").get("deposit")) |
                                        for (@total <- totalCh) {
                                          new wCh in {
                                            @account!("withdraw", *dId,
                                              listing.get("terms").get("assetId"),
                                              total, *wCh) |
                                            for (@w <- wCh) {
                                              match w {
                                                (true, payment) => {
                                                  new mCh in {
                                                    @issuer!("getAmountOf",
                                                             payment, *mCh) |
                                                    for (@m <- mCh) {
                                                      match m {
                                                        (true, measured) => {
                                                          if (measured != total) {
                                                            1/0
                                                          } else {
                                                            new depCh in {
                                                              @purse!("deposit",
                                                                payment, *depCh) |
                                                              for (@dd <- depCh) {
                                                                match dd {
                                                                  (true, balance) => {
                                                                    new settleToken, bondCh in {
                                                                      bookingBond!(
                                                                        purse, brand,
                                                                        listing.get("terms").get("assetId"),
                                                                        rent + listing.get("terms").get("deposit"),
                                                                        *settleToken, *bondCh) |
                                                                      for (@br <- bondCh) {
                                                                        match br {
                                                                          (true, bondUri) => {
                                                                            GuestLedgerSpawn!(
                                                                              *ledgerState,
                                                                              *releaseToken,
                                                                              *dId,
                                                                              guestId,
                                                                              listing,
                                                                              listingUri,
                                                                              unitSlots,
                                                                              opId,
                                                                              bookingId,
                                                                              untilHeight,
                                                                              checkInHeight,
                                                                              checkOutHeight,
                                                                              slotCount,
                                                                              rent,
                                                                              bondUri,
                                                                              *settleToken,
                                                                              *ret)
                                                                          }
                                                                          _ => { 1/0 }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                  _ => { 1/0 }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                        _ => { 1/0 }
                                                      }
                                                    }
                                                  }
                                                }
                                                _ => {
                                                  new relCh in {
                                                    ledgerReleaseUnits!(
                                                      unitSlots, 0,
                                                      *releaseToken, *relCh) |
                                                    for (@_ <- relCh) {
                                                      GuestLedgerDrop!(
                                                        *ledgerState, opId) |
                                                      ret!(w)
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                    _ => { 1/0 }
                                  }
                                }
                              }
                            }
                          }
                          _ => { 1/0 }
                        }
                      }
                    }
                  }
                  _ => { 1/0 }
                }
              }
            }
          }
          _ => { 1/0 }
        }
      }
    }
  } |

  contract GuestLedgerSpawn(ledgerState, releaseToken, dId,
                            @guestId, @listing, @listingUri, @unitSlots,
                            @opId, @bookingId, @untilHeight, @checkInHeight,
                            @checkOutHeight, @slotCount, @rent, @bondUri,
                            settleToken, ret) = {
    new fCh in {
      ledgerBookingFactory!(*fCh) |
      for (@f <- fCh) {
        match f {
          (true, BookingFactory) => {
            new cfCh in {
              if (listing.get("terms").get("instantBook") == true) {
                ledgerConfirmUnits!(unitSlots, 0, *releaseToken, *cfCh)
              } else {
                cfCh!((true, Nil))
              } |
              for (@cf <- cfCh) {
                match cf {
                  (true, Nil) => {
                    new statusCh in {
                      if (listing.get("terms").get("instantBook") == true) {
                        statusCh!("confirmed")
                      } else {
                        statusCh!("requested")
                      } |
                      for (@initialStatus <- statusCh) {
                        new dCh in {
                          dCh!({
                            "status": initialStatus,
                            "bookingId": bookingId,
                        "guestId": guestId,
                        "providerId": listing.get("providerId"),
                        "listingId": listing.get("listingId"),
                        "listingUri": listingUri,
                        "kind": listing.get("kind"),
                        "unitSlots": unitSlots,
                        "assetId": listing.get("terms").get("assetId"),
                        "rent": rent,
                        "deposit": listing.get("terms").get("deposit"),
                        "feeBps": listing.get("terms").get("feeBps"),
                        "holdUntilHeight": untilHeight,
                        "checkInHeight": checkInHeight,
                        "checkOutHeight": checkOutHeight,
                        "cancellation": listing.get("terms"),
                        "admins": listing.get("admins"),
                        "threshold": listing.get("threshold"),
                        "instantBook": listing.get("terms").get("instantBook")
                      }) |
                      for (@data <- dCh) {
                        new cCh in {
                          @BookingFactory!("create", *dId, data, *releaseToken,
                                           bondUri, *settleToken, *cCh) |
                          for (@r <- cCh) {
                            match r {
                              (true, bookingUri) => {
                                GuestLedgerFinish!(*ledgerState, opId,
                                  {"pending": false, "ok": true,
                                   "bookingId": bookingId,
                                   "uri": bookingUri}) |
                                ret!((true, bookingId, bookingUri))
                              }
                              _ => { 1/0 }
                            }
                          }
                        }
                      }
                    }
                      }
                    }
                  }
                  _ => { 1/0 }
                }
              }
            }
          }
          _ => { 1/0 }
        }
      }
    }
  } |

  // ---- factory and instance ----------------------------------------------------------

  contract GuestLedgerFactory(@"create", dId, @guestId, ret) = {
    new oCh in {
      authIsOwner!(*dId, guestId, *oCh) |
      for (@v <- oCh) {
        match v {
          (true, Nil) => {
            new pCh in {
              ledgerPayments!(*pCh) |
              for (@p <- pCh) {
                match p {
                  (true, Payments) => {
                    new aCh in {
                      @Payments!("ensureAccount", *dId, *aCh) |
                      for (@a <- aCh) {
                        match a {
                          (true, account, ownerId) => {
                            if (ownerId != guestId) {
                              ret!((false, "account"))
                            } else {
                              new GuestLedger, ledgerState, uCh in {
                                ledgerState!({"guestId": guestId, "ops": {}}) |
                                contract GuestLedger(@"ops", dId2, ret2) = {
                                  new o2 in {
                                    authIsOwner!(*dId2, guestId, *o2) |
                                    for (@v2 <- o2) {
                                      match v2 {
                                        (true, Nil) => {
                                          for (@st <<- ledgerState) {
                                            ret2!((true, st.get("ops")))
                                          }
                                        }
                                        _ => { ret2!(v2) }
                                      }
                                    }
                                  }
                                } |
                                contract GuestLedger(@"book", dId2, @listingUri,
                                                    @unitSlots, @opId,
                                                    @expectedTermsHash, ret2) = {
                                  new o2 in {
                                    authIsOwner!(*dId2, guestId, *o2) |
                                    for (@v2 <- o2) {
                                      match v2 {
                                        (true, Nil) => {
                                          new gateCh in {
                                            GuestLedgerGate!(*gateCh) |
                                            for (@g <- gateCh) {
                                              match g {
                                                (true, Nil) => {
                                                  new svCh in {
                                                    GuestLedgerReserve!(*ledgerState,
                                                                        opId, *svCh) |
                                                    for (@reserved <- svCh) {
                                                      match reserved {
                                                        (false, reason) => {
                                                          ret2!((false, reason))
                                                        }
                                                        (true, Nil) => {
                                                          new lcCh in {
                                                            rl!(listingUri, *lcCh) |
                                                            for (Listing <- lcCh) {
                                                              new liCh in {
                                                                Listing!("info", *liCh) |
                                                                for (@li <- liCh) {
                                                                  match li {
                                                                    (true, listing) => {
                                                                      if (listing.get("status") != "active") {
                                                                        GuestLedgerDrop!(
                                                                          *ledgerState, opId) |
                                                                        ret2!((false, "listing inactive"))
                                                                      } else {
                                                                        if (expectedTermsHash != Nil
                                                                            && expectedTermsHash != listing.get("termsHash")) {
                                                                          GuestLedgerDrop!(
                                                                            *ledgerState, opId) |
                                                                          ret2!((false, "terms"))
                                                                        } else {
                                                                          GuestLedgerBook!(
                                                                            *ledgerState,
                                                                            *dId2, guestId,
                                                                            listing, listingUri,
                                                                            unitSlots, opId,
                                                                            *ret2)
                                                                        }
                                                                      }
                                                                    }
                                                                    _ => {
                                                                      GuestLedgerDrop!(
                                                                        *ledgerState, opId) |
                                                                      ret2!(li)
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                        (true, entry) => {
                                                          if (entry.get("ok") == true) {
                                                            ret2!((true,
                                                                   entry.get("bookingId"),
                                                                   entry.get("uri")))
                                                          } else {
                                                            ret2!((false,
                                                                   entry.get("reason")))
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                                _ => { ret2!((false, "paused")) }
                                              }
                                            }
                                          }
                                        }
                                        _ => { ret2!(v2) }
                                      }
                                    }
                                  }
                                } |
                                rs!(bundle+{*GuestLedger}, *uCh) |
                                for (@uri <- uCh) { ret!((true, uri)) }
                              }
                            }
                          }
                          _ => { ret!((false, "account")) }
                        }
                      }
                    }
                  }
                  _ => { ret!((false, "payments unavailable")) }
                }
              }
            }
          }
          _ => { ret!(v) }
        }
      }
    }
  } |

  rl!(`__ROOT_URI__`, *rootCh) |
  for (Root <- rootCh) {
    rs!(bundle+{*GuestLedgerFactory}, *c) |
    for (@uri <- c) {
      Root!("register", "component:guest-ledger-factory", uri, 1,
            "booking", *deployerId, *ack) |
      for (@r <- ack) { deployId!([uri]) }
    }
  }
}
