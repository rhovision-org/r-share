// UnitFactory: one UnitContract per bookable unit, one SlotContract per slot.
// A Unit stores slot URIs (data), never live slot capabilities, so no capability is
// captured in a bundle. Each slot has its own cell: disjoint slots commit independently.
// Placeholders: __ROOT_URI__.
new
  UnitFactory,
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, c, ack,
  adminGuard, authIsOwner, authOwner, unitAllConfirm, unitAllHold, unitAllRelease, unitClock, unitSchedule, unitTerms, unitMin, unitMax, unitSlotScan, unitUnitCheck, unitScanUnits,
  resolveComponent
in {
contract resolveComponent(@key, ret) = {
  new rCh, Root, kCh in {
    rl!(`__ROOT_URI__`, *rCh) |
    for (Root <- rCh) {
      Root!("resolve", key, 1, *kCh) |
      for (@r <- kCh) {
        match r {
          (true, uri, _) => {
            new cCh in {
              rl!(uri, *cCh) |
              for (C <- cCh) { ret!((true, *C)) }
            }
          }
          _ => { ret!((false, "unavailable", key)) }
        }
      }
    }
  }
} |
// Deployer identity helpers. r-cash owns accounts; r-share only derives the owner id.

contract authOwner(dId, ret) = {
  new dops(`rho:rchain:deployerId:ops`), rev(`rho:rev:address`), pkCh, addrCh in {
    dops!("pubKeyBytes", *dId, *pkCh) |
    for (@pk <- pkCh) {
      rev!("fromPublicKey", pk, *addrCh) |
      for (@addr <- addrCh) { ret!((true, addr)) }
    }
  }
} |

contract authIsOwner(dId, @ownerId, ret) = {
  new c in {
    authOwner!(*dId, *c) |
    for (@r <- c) {
      match r {
        (true, addr) => {
          if (addr == ownerId) { ret!((true, Nil)) }
          else { ret!((false, "not owner")) }
        }
        _ => { ret!((false, "not owner")) }
      }
    }
  }
} |

contract adminGuard(@domain, @nonce, @action, @args, @sigs,
                    @admins, @threshold, ret) = {
  new rCh, Root, gCh, gc in {
    rl!(`__ROOT_URI__`, *rCh) |
    for (Root <- rCh) {
      Root!("resolve", "component:admin-guard", 1, *gCh) |
      for (@r <- gCh) {
        match r {
          (true, uri, _) => {
            rl!(uri, *gc) |
            for (AdminGuard <- gc) {
              AdminGuard!("verify", domain, nonce, action, args, sigs,
                          admins, threshold, *ret)
            }
          }
          _ => { ret!((false, "below threshold")) }
        }
      }
    }
  }
} |


  contract unitClock(ret) = {
    new rCh, Root, uCh, cCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:clock", 1, *uCh) |
        for (@(true, uri, _) <- uCh) {
          rl!(uri, *cCh) |
          for (Clock <- cCh) { Clock!("now", *ret) }
        }
      }
    }
  } |

  contract unitTerms(ret) = {
    resolveComponent!("component:terms", *ret)
  } |

  contract UnitFactory(@"validate", @kind, @slots, @maxLeadBlocks,
                       @maxSlotBlocks, @contiguous, ret) = {
    new pCh, nCh in {
      unitTerms!(*pCh) |
      unitClock!(*nCh) |
      for (@p <- pCh; @n <- nCh) {
        match p {
          (true, Terms) => {
            match n {
              (true, now) => {
                @Terms!("scheduleOk", kind, slots, now,
                        maxLeadBlocks, maxSlotBlocks, contiguous, *ret)
              }
              _ => { ret!(n) }
            }
          }
          _ => { ret!(p) }
        }
      }
    }
  } |

  contract unitSchedule(@specs, @i, @acc, ret) = {
    if (i >= specs.length()) {
      ret!(acc)
    } else {
      match specs.nth(i) {
        spec => {
          match spec.get("slotId") {
            slotId => { unitSchedule!(specs, i + 1, acc.set(slotId, spec), *ret) }
          }
        }
      }
    }
  } |

  contract UnitFactory(@"create", dId, @unitId, @providerId, @listingId, @kind,
                       @attrs, @slots, @maxHoldBlocks, @admins, @threshold,
                       @pricePerSlot, ret) = {
    new oCh in {
      authIsOwner!(*dId, providerId, *oCh) |
      for (@v <- oCh) {
        match v {
          (true, Nil) => {
            if (pricePerSlot < 1 || pricePerSlot > 1000000000000) {
              ret!((false, "price"))
            } else {
            new schCh in {
              unitSchedule!(slots, 0, {}, *schCh) |
              for (@schedule <- schCh) {
                new UnitContract, unitState, resetToken, uCh,
                    unitSlotUri, unitSlotHold, unitSlotRelease, unitSlotConfirm,
                    unitSlotProbe, unitSlotReset, unitHoldSeq, unitReleaseSeq,
                    unitConfirmSeq, unitProbeSeq, unitScheduleCollect,
                    unitMakeSlots in {
                  unitState!({
                    "unitId": unitId,
                    "listingId": listingId,
                    "providerId": providerId,
                    "kind": kind,
                    "attrs": attrs,
                    "slots": {},
                    "schedule": schedule,
                    "maxHoldBlocks": maxHoldBlocks,
                    "status": "active",
                    "admins": admins,
                    "threshold": threshold,
                    "pricePerSlot": pricePerSlot,
                    "nonce": 0
                  }) |

                  contract unitSlotUri(@slotId, ret2) = {
                    for (@st <<- unitState) {
                      match st.get("slots").get(slotId) {
                        Nil => { ret2!((false, "unknown slot")) }
                        uri => { ret2!((true, uri)) }
                      }
                    }
                  } |

                  contract unitSlotHold(@slotId, @bId, @until, @now,
                                        releaseToken, ret2) = {
                    new sCh in {
                      unitSlotUri!(slotId, *sCh) |
                      for (@r <- sCh) {
                        match r {
                          (true, uri) => {
                            new cCh in {
                              rl!(uri, *cCh) |
                              for (Slot <- cCh) {
                                Slot!("hold", bId, until, now, *releaseToken, *ret2)
                              }
                            }
                          }
                          _ => { ret2!(r) }
                        }
                      }
                    }
                  } |

                  contract unitSlotRelease(@slotId, releaseToken, ret2) = {
                    new sCh in {
                      unitSlotUri!(slotId, *sCh) |
                      for (@r <- sCh) {
                        match r {
                          (true, uri) => {
                            new cCh in {
                              rl!(uri, *cCh) |
                              for (Slot <- cCh) {
                                Slot!("release", *releaseToken, *ret2)
                              }
                            }
                          }
                          _ => { ret2!(r) }
                        }
                      }
                    }
                  } |

                  contract unitSlotConfirm(@slotId, releaseToken, ret2) = {
                    new sCh in {
                      unitSlotUri!(slotId, *sCh) |
                      for (@r <- sCh) {
                        match r {
                          (true, uri) => {
                            new cCh in {
                              rl!(uri, *cCh) |
                              for (Slot <- cCh) {
                                Slot!("confirm", *releaseToken, *ret2)
                              }
                            }
                          }
                          _ => { ret2!(r) }
                        }
                      }
                    }
                  } |

                  contract unitSlotProbe(@slotId, ret2) = {
                    new sCh in {
                      unitSlotUri!(slotId, *sCh) |
                      for (@r <- sCh) {
                        match r {
                          (true, uri) => {
                            new cCh in {
                              rl!(uri, *cCh) |
                              for (Slot <- cCh) { Slot!("probe", *ret2) }
                            }
                          }
                          _ => { ret2!(r) }
                        }
                      }
                    }
                  } |

                  contract unitSlotReset(@slotId, ret2) = {
                    new sCh in {
                      unitSlotUri!(slotId, *sCh) |
                      for (@r <- sCh) {
                        match r {
                          (true, uri) => {
                            new cCh in {
                              rl!(uri, *cCh) |
                              for (Slot <- cCh) {
                                Slot!("reset", *resetToken, *ret2)
                              }
                            }
                          }
                          _ => { ret2!(r) }
                        }
                      }
                    }
                  } |

                  contract unitHoldSeq(@ids, @i, @bId, @until, @now,
                                       releaseToken, ret2) = {
                    if (i >= ids.length()) {
                      ret2!((true, Nil))
                    } else {
                      new hCh in {
                        unitSlotHold!(ids.nth(i), bId, until, now,
                                      *releaseToken, *hCh) |
                        for (@h <- hCh) {
                          match h {
                            (true, Nil) => {
                              unitHoldSeq!(ids, i + 1, bId, until, now,
                                           *releaseToken, *ret2)
                            }
                            _ => {
                              new rCh in {
                                unitReleaseSeq!(ids, 0, *releaseToken, *rCh) |
                                for (@_ <- rCh) { ret2!(h) }
                              }
                            }
                          }
                        }
                      }
                    }
                  } |

                  contract unitReleaseSeq(@ids, @i, releaseToken, ret2) = {
                    if (i >= ids.length()) {
                      ret2!((true, Nil))
                    } else {
                      new rCh in {
                        unitSlotRelease!(ids.nth(i), *releaseToken, *rCh) |
                        for (@r <- rCh) {
                          match r {
                            (true, Nil) => {
                              unitReleaseSeq!(ids, i + 1, *releaseToken, *ret2)
                            }
                            _ => { ret2!(r) }
                          }
                        }
                      }
                    }
                  } |

                  contract unitConfirmSeq(@ids, @i, releaseToken, ret2) = {
                    if (i >= ids.length()) {
                      ret2!((true, Nil))
                    } else {
                      new c2 in {
                        unitSlotConfirm!(ids.nth(i), *releaseToken, *c2) |
                        for (@r <- c2) {
                          match r {
                            (true, Nil) => {
                              unitConfirmSeq!(ids, i + 1, *releaseToken, *ret2)
                            }
                            _ => {
                              new relCh in {
                                unitReleaseSeq!(ids, 0, *releaseToken, *relCh) |
                                for (@_ <- relCh) { ret2!((false, "slot lost")) }
                              }
                            }
                          }
                        }
                      }
                    }
                  } |

                  contract unitProbeSeq(@ids, @i, @acc, ret2) = {
                    if (i >= ids.length()) {
                      ret2!((true, acc))
                    } else {
                      new pCh in {
                        unitSlotProbe!(ids.nth(i), *pCh) |
                        for (@p <- pCh) {
                          match p {
                            (true, state) => {
                              unitProbeSeq!(ids, i + 1,
                                            acc.set(ids.nth(i), state), *ret2)
                            }
                            _ => { ret2!(p) }
                          }
                        }
                      }
                    }
                  } |

                  contract unitScheduleCollect(@ids, @i, @schedule, @acc, ret2) = {
                    if (i >= ids.length()) {
                      ret2!((true, acc))
                    } else {
                      match schedule.get(ids.nth(i)) {
                        Nil => { ret2!((false, "unknown slot")) }
                        spec => {
                          unitScheduleCollect!(ids, i + 1, schedule,
                                               acc.set(ids.nth(i), spec), *ret2)
                        }
                      }
                    }
                  } |

                  contract UnitContract(@"info", ret2) = {
                    for (@st <<- unitState) { ret2!((true, st)) }
                  } |
                  contract UnitContract(@"slots", ret2) = {
                    for (@st <<- unitState) { ret2!((true, st.get("slots").keys())) }
                  } |
                  contract UnitContract(@"schedule", @slotIds, ret2) = {
                    for (@st <<- unitState) {
                      new sCh in {
                        unitScheduleCollect!(slotIds, 0, st.get("schedule"), {},
                                             *sCh) |
                        for (@r <- sCh) { ret2!(r) }
                      }
                    }
                  } |
                  contract UnitContract(@"probe", @slotIds, ret2) = {
                    new pCh in {
                      unitProbeSeq!(slotIds, 0, {}, *pCh) |
                      for (@r <- pCh) { ret2!(r) }
                    }
                  } |
                  contract UnitContract(@"hold", @bookingId, @slotIds,
                                        @untilHeight, releaseToken, ret2) = {
                    new nowCh in {
                      unitClock!(*nowCh) |
                      for (@n <- nowCh) {
                        match n {
                          (true, now) => {
                            for (@st <<- unitState) {
                              if (st.get("status") != "active") {
                                ret2!((false, "unit paused"))
                              } else {
                                if (now >= untilHeight
                                    || untilHeight > now + st.get("maxHoldBlocks")) {
                                  ret2!((false, "until"))
                                } else {
                                  new hCh in {
                                    unitHoldSeq!(slotIds, 0, bookingId, untilHeight,
                                                 now, *releaseToken, *hCh) |
                                    for (@h <- hCh) {
                                      match h {
                                        (true, Nil) => {
                                          for (@st2 <<- unitState) {
                                            if (st2.get("status") != "active") {
                                              new relCh in {
                                                unitReleaseSeq!(slotIds, 0,
                                                                *releaseToken, *relCh) |
                                                for (@_ <- relCh) {
                                                  ret2!((false, "unit paused"))
                                                }
                                              }
                                            } else {
                                              ret2!((true, Nil))
                                            }
                                          }
                                        }
                                        _ => { ret2!(h) }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                          _ => { ret2!(n) }
                        }
                      }
                    }
                  } |
                  contract UnitContract(@"release", @slotIds, releaseToken, ret2) = {
                    unitReleaseSeq!(slotIds, 0, *releaseToken, *ret2)
                  } |
                  contract UnitContract(@"confirm", @slotIds, releaseToken, ret2) = {
                    unitConfirmSeq!(slotIds, 0, *releaseToken, *ret2)
                  } |
                  contract UnitContract(@"reset", dId2, @slotId, ret2) = {
                    new oCh2 in {
                      authIsOwner!(*dId2, providerId, *oCh2) |
                      for (@v <- oCh2) {
                        match v {
                          (true, Nil) => { unitSlotReset!(slotId, *ret2) }
                          _ => { ret2!(v) }
                        }
                      }
                    }
                  } |
                  contract UnitContract(@"adminPause", @nonce, @sigs, ret2) = {
                    for (@st <- unitState) {
                      if (nonce <= st.get("nonce")) {
                        unitState!(st) | ret2!((false, "replay"))
                      } else {
                        new vCh in {
                          adminGuard!("unit:" ++ unitId, nonce, "pause", [], sigs,
                                       st.get("admins"), st.get("threshold"), *vCh) |
                          for (@v <- vCh) {
                            match v {
                              (true, ok) => {
                                if (ok == false) {
                                  unitState!(st) | ret2!((false, "below threshold"))
                                } else {
                                  unitState!(st.set("status", "paused")
                                               .set("nonce", nonce)) |
                                  ret2!((true, Nil))
                                }
                              }
                              _ => { unitState!(st) | ret2!((false, "below threshold")) }
                            }
                          }
                        }
                      }
                    }
                  } |
                  contract UnitContract(@"setAdmins", @nonce, @newAdmins,
                                        @newThreshold, @sigs, ret2) = {
                    for (@st <- unitState) {
                      if (nonce <= st.get("nonce")) {
                        unitState!(st) | ret2!((false, "replay"))
                      } else {
                        new vCh in {
                          adminGuard!("unit:" ++ unitId, nonce, "setAdmins",
                                       [newAdmins, newThreshold], sigs,
                                       st.get("admins"), st.get("threshold"), *vCh) |
                          for (@v <- vCh) {
                            match v {
                              (true, ok) => {
                                if (ok == false) {
                                  unitState!(st) | ret2!((false, "below threshold"))
                                } else {
                                  if (newThreshold < 1
                                      || newThreshold > newAdmins.length()) {
                                    unitState!(st) | ret2!((false, "threshold"))
                                  } else {
                                    unitState!(st.set("admins", newAdmins)
                                                 .set("threshold", newThreshold)
                                                 .set("nonce", nonce)) |
                                    ret2!((true, Nil))
                                  }
                                }
                              }
                              _ => { unitState!(st) | ret2!((false, "below threshold")) }
                            }
                          }
                        }
                      }
                    }
                  } |

                  contract unitMakeSlots(@specs, @i, @acc, ret2) = {
                    if (i >= specs.length()) {
                      ret2!(acc)
                    } else {
                      match specs.nth(i) {
                        spec => {
                          match spec.get("slotId") {
                            slotId => {
                              new SlotContract, slotState, sCh in {
                                slotState!(["free", 0]) |
                                contract SlotContract(@"probe", ret3) = {
                                  for (@sl <<- slotState) {
                                    match sl {
                                      ["free", gen] => { ret3!((true, sl)) }
                                      ["held", bId, until, token] => {
                                        ret3!((true, ["held", bId, until]))
                                      }
                                      ["booked", bId, token] => {
                                        ret3!((true, ["booked", bId]))
                                      }
                                      _ => { ret3!((true, ["invalid"])) }
                                    }
                                  }
                                } |
                                contract SlotContract(@"hold", @bookingId, @untilHeight,
                                                      @now, releaseToken, ret3) = {
                                  for (@sl <- slotState) {
                                    match sl {
                                      ["free", gen] => {
                                        slotState!(["held", bookingId, untilHeight,
                                                    *releaseToken]) |
                                        ret3!((true, Nil))
                                      }
                                      ["held", oldId, oldUntil, oldToken] => {
                                        if (now >= oldUntil) {
                                          slotState!(["held", bookingId, untilHeight,
                                                      *releaseToken]) |
                                          ret3!((true, Nil))
                                        } else {
                                          slotState!(sl) |
                                          ret3!((false, "slot held", oldUntil))
                                        }
                                      }
                                      _ => {
                                        slotState!(sl) | ret3!((false, "slot held"))
                                      }
                                    }
                                  }
                                } |
                                contract SlotContract(@"release", releaseToken, ret3) = {
                                  for (@sl <- slotState) {
                                    match sl {
                                      ["free", gen] => {
                                        slotState!(sl) | ret3!((true, Nil))
                                      }
                                      ["held", bId, until, token] => {
                                        if (token == *releaseToken) {
                                          slotState!(["free", 0]) |
                                          ret3!((true, Nil))
                                        } else {
                                          slotState!(sl) |
                                          ret3!((false, "not holder"))
                                        }
                                      }
                                      ["booked", bId, token] => {
                                        if (token == *releaseToken) {
                                          slotState!(["free", 0]) |
                                          ret3!((true, Nil))
                                        } else {
                                          slotState!(sl) |
                                          ret3!((false, "not holder"))
                                        }
                                      }
                                      _ => {
                                        slotState!(sl) | ret3!((false, "not holder"))
                                      }
                                    }
                                  }
                                } |
                                contract SlotContract(@"confirm", releaseToken, ret3) = {
                                  for (@sl <- slotState) {
                                    match sl {
                                      ["held", bId, until, token] => {
                                        if (token == *releaseToken) {
                                          slotState!(["booked", bId, token]) |
                                          ret3!((true, Nil))
                                        } else {
                                          slotState!(sl) |
                                          ret3!((false, "not held"))
                                        }
                                      }
                                      _ => {
                                        slotState!(sl) | ret3!((false, "not held"))
                                      }
                                    }
                                  }
                                } |
                                contract SlotContract(@"reset", resetToken2, ret3) = {
                                  for (@sl <- slotState) {
                                    if (*resetToken2 == *resetToken) {
                                      match sl {
                                        ["free", gen] => {
                                          slotState!(sl) | ret3!((true, Nil))
                                        }
                                        _ => {
                                          slotState!(["free", 0]) |
                                          ret3!((true, Nil))
                                        }
                                      }
                                    } else {
                                      slotState!(sl) | ret3!((false, "not provider"))
                                    }
                                  }
                                } |
                                rs!(bundle+{*SlotContract}, *sCh) |
                                for (@uri <- sCh) {
                                  unitMakeSlots!(specs, i + 1,
                                                 acc.set(slotId, uri), *ret2)
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  } |

                  new slotsCh in {
                    unitMakeSlots!(slots, 0, {}, *slotsCh) |
                    for (@slotMap <- slotsCh) {
                      for (@st <- unitState) {
                        unitState!(st.set("slots", slotMap)) |
                        rs!(bundle+{*UnitContract}, *uCh) |
                        for (@uri <- uCh) { ret!((true, uri)) }
                      }
                    }
                  }
                }
              }
              }
            }
          }
          _ => { ret!(v) }
        }
      }
    }
  } |

  contract unitMin(@a, @b, ret) = { if (a < b) { ret!(a) } else { ret!(b) } } |
  contract unitMax(@a, @b, ret) = { if (a > b) { ret!(a) } else { ret!(b) } } |

  contract unitSlotScan(@ids, @j, @specMap, @stateMap, @now,
                          @maxLead, @maxSlot, @count, @minStart, @maxEnd, ret) = {
    if (j >= ids.length()) {
      ret!((true, {"count": count, "minStart": minStart, "maxEnd": maxEnd}))
    } else {
      match ids.nth(j) {
        slotId => {
          match specMap.get(slotId) {
            Nil => { ret!((false, "unknown slot")) }
            spec => {
              match stateMap.get(slotId) {
                Nil => { ret!((false, "unknown slot")) }
                state => {
                  match spec.get("startHeight") {
                    Nil => { ret!((false, "schedule")) }
                    startHeight => {
                      match spec.get("endHeight") {
                        Nil => { ret!((false, "schedule")) }
                        endHeight => {
                          if (startHeight >= endHeight) {
                            ret!((false, "schedule"))
                          } else {
                            if (startHeight <= now) {
                              ret!((false, "schedule"))
                            } else {
                              if (startHeight > now + maxLead) {
                                ret!((false, "lead"))
                              } else {
                                if (endHeight - startHeight > maxSlot) {
                                  ret!((false, "duration"))
                                } else {
                                  match state {
                                    ["free", gen] => {
                                      new mnCh, mxCh in {
                                        unitMin!(minStart, startHeight, *mnCh) |
                                        unitMax!(maxEnd, endHeight, *mxCh) |
                                        for (@mn <- mnCh; @mx <- mxCh) {
                                          unitSlotScan!(ids, j + 1, specMap, stateMap,
                                                          now, maxLead, maxSlot,
                                                          count + 1, mn, mx, *ret)
                                        }
                                      }
                                    }
                                    ["held", bId, until] => {
                                      if (now >= until) {
                                        new mnCh, mxCh in {
                                          unitMin!(minStart, startHeight, *mnCh) |
                                          unitMax!(maxEnd, endHeight, *mxCh) |
                                          for (@mn <- mnCh; @mx <- mxCh) {
                                            unitSlotScan!(ids, j + 1, specMap, stateMap,
                                                            now, maxLead, maxSlot,
                                                            count + 1, mn, mx, *ret)
                                          }
                                        }
                                      } else {
                                        ret!((false, "slot held", slotId, until))
                                      }
                                    }
                                    _ => { ret!((false, "slot held", slotId)) }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract unitUnitCheck(@unitUri, @listingId, @slotIds, @wantedIn, @wantedOut,
                           @now, @maxLead, @maxSlot, ret) = {
    new cCh in {
      rl!(unitUri, *cCh) |
      for (Unit <- cCh) {
        new iCh in {
          Unit!("info", *iCh) |
          for (@i <- iCh) {
            match i {
              (true, unit) => {
                if (unit.get("listingId") != listingId) {
                  ret!((false, "unit listing"))
                } else {
                  new sCh, pCh in {
                    Unit!("schedule", slotIds, *sCh) |
                    Unit!("probe", slotIds, *pCh) |
                    for (@ss <- sCh; @ps <- pCh) {
                      match ss {
                        (true, specMap) => {
                          match ps {
                            (true, stateMap) => {
                              new scanCh in {
                                unitSlotScan!(slotIds, 0, specMap, stateMap,
                                                now, maxLead, maxSlot,
                                                0, now + maxLead + 1, 0, *scanCh) |
                                for (@part <- scanCh) {
                                  match part {
                                    (true, summary) => {
                                      match unit.get("pricePerSlot") {
                                        Nil => { ret!((false, "price")) }
                                        price => {
                                          new inCh, outCh in {
                                            if (wantedIn == Nil) {
                                              inCh!(summary.get("minStart"))
                                            } else {
                                              inCh!(wantedIn)
                                            } |
                                            if (wantedOut == Nil) {
                                              outCh!(summary.get("maxEnd"))
                                            } else {
                                              outCh!(wantedOut)
                                            } |
                                            for (@ci <- inCh; @co <- outCh) {
                                              if (ci < summary.get("minStart")
                                                  || ci >= summary.get("maxEnd")
                                                  || co > summary.get("maxEnd")
                                                  || co <= ci) {
                                                ret!((false, "window"))
                                              } else {
                                                ret!((true,
                                                  summary.set(
                                                    "rent", price * summary.get("count"))
                                                           .set("checkIn", ci)
                                                           .set("checkOut", co)))
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                    _ => { ret!(part) }
                                  }
                                }
                              }
                            }
                            _ => { ret!(ps) }
                          }
                        }
                        _ => { ret!(ss) }
                      }
                    }
                  }
                }
              }
              _ => { ret!(i) }
            }
          }
        }
      }
    }
  } |

  contract unitScanUnits(@unitSlots, @i, @listingId, @now, @maxLead,
                           @maxSlot, @count, @minStart, @maxEnd,
                           @minCheckIn, @maxCheckOut, @rent, ret) = {
    if (i >= unitSlots.length()) {
      ret!((true, {"count": count, "minStart": minStart, "maxEnd": maxEnd,
                   "checkIn": minCheckIn, "checkOut": maxCheckOut,
                   "rent": rent}))
    } else {
      match unitSlots.nth(i) {
        us => {
          new cCh in {
            unitUnitCheck!(us.get("unitUri"), listingId, us.get("slots"),
                             us.get("checkInHeight"), us.get("checkOutHeight"),
                             now, maxLead, maxSlot, *cCh) |
            for (@r <- cCh) {
              match r {
                (true, part) => {
                  new mnCh, mxCh, ciCh, coCh in {
                    unitMin!(minStart, part.get("minStart"), *mnCh) |
                    unitMax!(maxEnd, part.get("maxEnd"), *mxCh) |
                    unitMin!(minCheckIn, part.get("checkIn"), *ciCh) |
                    unitMax!(maxCheckOut, part.get("checkOut"), *coCh) |
                    for (@mn <- mnCh; @mx <- mxCh; @ci <- ciCh; @co <- coCh) {
                      unitScanUnits!(unitSlots, i + 1, listingId, now, maxLead,
                                       maxSlot, count + part.get("count"),
                                       mn, mx, ci, co,
                                       rent + part.get("rent"), *ret)
                    }
                  }
                }
                _ => { ret!(r) }
              }
            }
          }
        }
      }
    }
  } |

  contract UnitFactory(@"scan", @unitSlots, @listingId, @now, @maxLead,
                       @maxSlot, ret) = {
    unitScanUnits!(unitSlots, 0, listingId, now, maxLead, maxSlot,
                   0, now + maxLead + 1, 0, now + maxLead + 1, 0, 0, *ret)
  } |

  contract unitAllHold(@unitSlots, @i, @bookingId, @until, releaseToken, ret) = {
    if (i >= unitSlots.length()) {
      ret!((true, Nil))
    } else {
      match unitSlots.nth(i) {
        us => {
          new cCh in {
            rl!(us.get("unitUri"), *cCh) |
            for (Unit <- cCh) {
              new hCh in {
                Unit!("hold", bookingId, us.get("slots"), until,
                      *releaseToken, *hCh) |
                for (@h <- hCh) {
                  match h {
                    (true, Nil) => {
                      unitAllHold!(unitSlots, i + 1, bookingId, until,
                                   *releaseToken, *ret)
                    }
                    _ => {
                      new relCh in {
                        unitAllRelease!(unitSlots, 0, *releaseToken, *relCh) |
                        for (@_ <- relCh) { ret!(h) }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract unitAllRelease(@unitSlots, @i, releaseToken, ret) = {
    if (i >= unitSlots.length()) {
      ret!((true, Nil))
    } else {
      match unitSlots.nth(i) {
        us => {
          new cCh in {
            rl!(us.get("unitUri"), *cCh) |
            for (Unit <- cCh) {
              new rCh in {
                Unit!("release", us.get("slots"), *releaseToken, *rCh) |
                for (@r <- rCh) {
                  match r {
                    (true, Nil) => {
                      unitAllRelease!(unitSlots, i + 1, *releaseToken, *ret)
                    }
                    _ => { ret!(r) }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract unitAllConfirm(@unitSlots, @i, releaseToken, ret) = {
    if (i >= unitSlots.length()) {
      ret!((true, Nil))
    } else {
      match unitSlots.nth(i) {
        us => {
          new cCh in {
            rl!(us.get("unitUri"), *cCh) |
            for (Unit <- cCh) {
              new c2 in {
                Unit!("confirm", us.get("slots"), *releaseToken, *c2) |
                for (@r <- c2) {
                  match r {
                    (true, Nil) => {
                      unitAllConfirm!(unitSlots, i + 1, *releaseToken, *ret)
                    }
                    _ => {
                      new relCh in {
                        unitAllRelease!(unitSlots, 0, *releaseToken, *relCh) |
                        for (@_ <- relCh) { ret!((false, "slot lost")) }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract UnitFactory(@"holdAll", @unitSlots, @bookingId, @until,
                       releaseToken, ret) = {
    unitAllHold!(unitSlots, 0, bookingId, until, *releaseToken, *ret)
  } |
  contract UnitFactory(@"releaseAll", @unitSlots, releaseToken, ret) = {
    unitAllRelease!(unitSlots, 0, *releaseToken, *ret)
  } |
  contract UnitFactory(@"confirmAll", @unitSlots, releaseToken, ret) = {
    unitAllConfirm!(unitSlots, 0, *releaseToken, *ret)
  } |

  rl!(`__ROOT_URI__`, *rootCh) |
  for (Root <- rootCh) {
    rs!(bundle+{*UnitFactory}, *c) |
    for (@uri <- c) {
      Root!("register", "component:unit-factory", uri, 1, "unit", *deployerId, *ack) |
      for (@r <- ack) { deployId!([uri]) }
    }
  }
}
