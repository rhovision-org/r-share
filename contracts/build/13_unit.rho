// UnitFactory: one UnitContract per bookable unit, one SlotContract per slot.
// A Unit stores slot URIs (data), never live slot capabilities, so no capability is
// captured in a bundle. Each slot has its own cell: disjoint slots commit independently.
// Placeholders: __ROOT_URI__.
new
  UnitFactory,
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, c, ack,
  adminGuard, authIsOwner, authOwner, unitAllConfirm, unitAllHold, unitAllRelease, unitClock, unitSchedule, unitTerms
in {
// Deployer identity helpers. r-cash owns accounts; r-share only derives the owner id.

contract authOwner(dId, ret) = {
  new dops(`rho:rchain:deployerId:ops`), rev(`rho:rev:address`), pkCh, addrCh in {
    dops!("pubKeyBytes", *dId, *pkCh) |
    for (@pk <- pkCh) {
      rev!("fromPublicKey", pk, *addrCh) |
      for (@addr <- addrCh) { ret!((true, addr)) }
    }
  }
} |

contract authIsOwner(dId, @ownerId, ret) = {
  new c in {
    authOwner!(*dId, *c) |
    for (@r <- c) {
      match r {
        (true, addr) => {
          if (addr == ownerId) { ret!((true, Nil)) }
          else { ret!((false, "not owner")) }
        }
        _ => { ret!((false, "not owner")) }
      }
    }
  }
} |

  contract adminGuard(@domain, @nonce, @action, @args, @sigs,
                      @admins, @threshold, ret) = {
    new rCh, Root, gCh, gc in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:admin-guard", 1, *gCh) |
        for (@r <- gCh) {
          match r {
            (true, uri, _) => {
              rl!(uri, *gc) |
              for (AdminGuard <- gc) {
                AdminGuard!("verify", domain, nonce, action, args, sigs,
                            admins, threshold, *ret)
              }
            }
            _ => { ret!((false, "below threshold")) }
          }
        }
      }
    }
  } |


  contract unitClock(ret) = {
    new rCh, Root, uCh, cCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:clock", 1, *uCh) |
        for (@(true, uri, _) <- uCh) {
          rl!(uri, *cCh) |
          for (Clock <- cCh) { Clock!("now", *ret) }
        }
      }
    }
  } |

  contract unitTerms(ret) = {
    new rCh, Root, uCh, cCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:terms", 1, *uCh) |
        for (@(true, uri, _) <- uCh) {
          rl!(uri, *cCh) |
          for (Terms <- cCh) { ret!((true, *Terms)) }
        }
      }
    }
  } |

  contract UnitFactory(@"validate", @kind, @slots, @maxLeadBlocks,
                       @maxSlotBlocks, @contiguous, ret) = {
    new pCh, nCh in {
      unitTerms!(*pCh) |
      unitClock!(*nCh) |
      for (@p <- pCh; @n <- nCh) {
        match p {
          (true, Terms) => {
            match n {
              (true, now) => {
                @Terms!("scheduleOk", kind, slots, now,
                        maxLeadBlocks, maxSlotBlocks, contiguous, *ret)
              }
              _ => { ret!(n) }
            }
          }
          _ => { ret!(p) }
        }
      }
    }
  } |

  contract unitSchedule(@specs, @i, @acc, ret) = {
    if (i >= specs.length()) {
      ret!(acc)
    } else {
      match specs.nth(i) {
        spec => {
          match spec.get("slotId") {
            slotId => { unitSchedule!(specs, i + 1, acc.set(slotId, spec), *ret) }
          }
        }
      }
    }
  } |

  contract UnitFactory(@"create", dId, @unitId, @providerId, @listingId, @kind,
                       @attrs, @slots, @maxHoldBlocks, @admins, @threshold,
                       @pricePerSlot, ret) = {
    new oCh in {
      authIsOwner!(*dId, providerId, *oCh) |
      for (@v <- oCh) {
        match v {
          (true, Nil) => {
            if (pricePerSlot < 1 || pricePerSlot > 1000000000000) {
              ret!((false, "price"))
            } else {
            new schCh in {
              unitSchedule!(slots, 0, {}, *schCh) |
              for (@schedule <- schCh) {
                new UnitContract, unitState, resetToken, uCh,
                    unitSlotUri, unitSlotHold, unitSlotRelease, unitSlotConfirm,
                    unitSlotProbe, unitSlotReset, unitHoldSeq, unitReleaseSeq,
                    unitConfirmSeq, unitProbeSeq, unitScheduleCollect,
                    unitMakeSlots in {
                  unitState!({
                    "unitId": unitId,
                    "listingId": listingId,
                    "providerId": providerId,
                    "kind": kind,
                    "attrs": attrs,
                    "slots": {},
                    "schedule": schedule,
                    "maxHoldBlocks": maxHoldBlocks,
                    "status": "active",
                    "admins": admins,
                    "threshold": threshold,
                    "pricePerSlot": pricePerSlot,
                    "nonce": 0
                  }) |

                  contract unitSlotUri(@slotId, ret2) = {
                    for (@st <<- unitState) {
                      match st.get("slots").get(slotId) {
                        Nil => { ret2!((false, "unknown slot")) }
                        uri => { ret2!((true, uri)) }
                      }
                    }
                  } |

                  contract unitSlotHold(@slotId, @bId, @until, @now,
                                        releaseToken, ret2) = {
                    new sCh in {
                      unitSlotUri!(slotId, *sCh) |
                      for (@r <- sCh) {
                        match r {
                          (true, uri) => {
                            new cCh in {
                              rl!(uri, *cCh) |
                              for (Slot <- cCh) {
                                Slot!("hold", bId, until, now, *releaseToken, *ret2)
                              }
                            }
                          }
                          _ => { ret2!(r) }
                        }
                      }
                    }
                  } |

                  contract unitSlotRelease(@slotId, releaseToken, ret2) = {
                    new sCh in {
                      unitSlotUri!(slotId, *sCh) |
                      for (@r <- sCh) {
                        match r {
                          (true, uri) => {
                            new cCh in {
                              rl!(uri, *cCh) |
                              for (Slot <- cCh) {
                                Slot!("release", *releaseToken, *ret2)
                              }
                            }
                          }
                          _ => { ret2!(r) }
                        }
                      }
                    }
                  } |

                  contract unitSlotConfirm(@slotId, releaseToken, ret2) = {
                    new sCh in {
                      unitSlotUri!(slotId, *sCh) |
                      for (@r <- sCh) {
                        match r {
                          (true, uri) => {
                            new cCh in {
                              rl!(uri, *cCh) |
                              for (Slot <- cCh) {
                                Slot!("confirm", *releaseToken, *ret2)
                              }
                            }
                          }
                          _ => { ret2!(r) }
                        }
                      }
                    }
                  } |

                  contract unitSlotProbe(@slotId, ret2) = {
                    new sCh in {
                      unitSlotUri!(slotId, *sCh) |
                      for (@r <- sCh) {
                        match r {
                          (true, uri) => {
                            new cCh in {
                              rl!(uri, *cCh) |
                              for (Slot <- cCh) { Slot!("probe", *ret2) }
                            }
                          }
                          _ => { ret2!(r) }
                        }
                      }
                    }
                  } |

                  contract unitSlotReset(@slotId, ret2) = {
                    new sCh in {
                      unitSlotUri!(slotId, *sCh) |
                      for (@r <- sCh) {
                        match r {
                          (true, uri) => {
                            new cCh in {
                              rl!(uri, *cCh) |
                              for (Slot <- cCh) {
                                Slot!("reset", *resetToken, *ret2)
                              }
                            }
                          }
                          _ => { ret2!(r) }
                        }
                      }
                    }
                  } |

                  contract unitHoldSeq(@ids, @i, @bId, @until, @now,
                                       releaseToken, ret2) = {
                    if (i >= ids.length()) {
                      ret2!((true, Nil))
                    } else {
                      new hCh in {
                        unitSlotHold!(ids.nth(i), bId, until, now,
                                      *releaseToken, *hCh) |
                        for (@h <- hCh) {
                          match h {
                            (true, Nil) => {
                              unitHoldSeq!(ids, i + 1, bId, until, now,
                                           *releaseToken, *ret2)
                            }
                            _ => {
                              new rCh in {
                                unitReleaseSeq!(ids, 0, *releaseToken, *rCh) |
                                for (@_ <- rCh) { ret2!(h) }
                              }
                            }
                          }
                        }
                      }
                    }
                  } |

                  contract unitReleaseSeq(@ids, @i, releaseToken, ret2) = {
                    if (i >= ids.length()) {
                      ret2!((true, Nil))
                    } else {
                      new rCh in {
                        unitSlotRelease!(ids.nth(i), *releaseToken, *rCh) |
                        for (@_ <- rCh) {
                          unitReleaseSeq!(ids, i + 1, *releaseToken, *ret2)
                        }
                      }
                    }
                  } |

                  contract unitConfirmSeq(@ids, @i, releaseToken, ret2) = {
                    if (i >= ids.length()) {
                      ret2!((true, Nil))
                    } else {
                      new c2 in {
                        unitSlotConfirm!(ids.nth(i), *releaseToken, *c2) |
                        for (@r <- c2) {
                          match r {
                            (true, Nil) => {
                              unitConfirmSeq!(ids, i + 1, *releaseToken, *ret2)
                            }
                            _ => {
                              new relCh in {
                                unitReleaseSeq!(ids, 0, *releaseToken, *relCh) |
                                for (@_ <- relCh) { ret2!((false, "slot lost")) }
                              }
                            }
                          }
                        }
                      }
                    }
                  } |

                  contract unitProbeSeq(@ids, @i, @acc, ret2) = {
                    if (i >= ids.length()) {
                      ret2!((true, acc))
                    } else {
                      new pCh in {
                        unitSlotProbe!(ids.nth(i), *pCh) |
                        for (@p <- pCh) {
                          match p {
                            (true, state) => {
                              unitProbeSeq!(ids, i + 1,
                                            acc.set(ids.nth(i), state), *ret2)
                            }
                            _ => { ret2!(p) }
                          }
                        }
                      }
                    }
                  } |

                  contract unitScheduleCollect(@ids, @i, @schedule, @acc, ret2) = {
                    if (i >= ids.length()) {
                      ret2!((true, acc))
                    } else {
                      match schedule.get(ids.nth(i)) {
                        Nil => { ret2!((false, "unknown slot")) }
                        spec => {
                          unitScheduleCollect!(ids, i + 1, schedule,
                                               acc.set(ids.nth(i), spec), *ret2)
                        }
                      }
                    }
                  } |

                  contract UnitContract(@"info", ret2) = {
                    for (@st <<- unitState) { ret2!((true, st)) }
                  } |
                  contract UnitContract(@"slots", ret2) = {
                    for (@st <<- unitState) { ret2!((true, st.get("slots").keys())) }
                  } |
                  contract UnitContract(@"schedule", @slotIds, ret2) = {
                    for (@st <<- unitState) {
                      new sCh in {
                        unitScheduleCollect!(slotIds, 0, st.get("schedule"), {},
                                             *sCh) |
                        for (@r <- sCh) { ret2!(r) }
                      }
                    }
                  } |
                  contract UnitContract(@"probe", @slotIds, ret2) = {
                    new pCh in {
                      unitProbeSeq!(slotIds, 0, {}, *pCh) |
                      for (@r <- pCh) { ret2!(r) }
                    }
                  } |
                  contract UnitContract(@"hold", @bookingId, @slotIds,
                                        @untilHeight, releaseToken, ret2) = {
                    new nowCh in {
                      unitClock!(*nowCh) |
                      for (@n <- nowCh) {
                        match n {
                          (true, now) => {
                            for (@st <<- unitState) {
                              if (st.get("status") != "active") {
                                ret2!((false, "unit paused"))
                              } else {
                                if (now >= untilHeight
                                    || untilHeight > now + st.get("maxHoldBlocks")) {
                                  ret2!((false, "until"))
                                } else {
                                  new hCh in {
                                    unitHoldSeq!(slotIds, 0, bookingId, untilHeight,
                                                 now, *releaseToken, *hCh) |
                                    for (@h <- hCh) {
                                      match h {
                                        (true, Nil) => {
                                          for (@st2 <<- unitState) {
                                            if (st2.get("status") != "active") {
                                              new relCh in {
                                                unitReleaseSeq!(slotIds, 0,
                                                                *releaseToken, *relCh) |
                                                for (@_ <- relCh) {
                                                  ret2!((false, "unit paused"))
                                                }
                                              }
                                            } else {
                                              ret2!((true, Nil))
                                            }
                                          }
                                        }
                                        _ => { ret2!(h) }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                          _ => { ret2!(n) }
                        }
                      }
                    }
                  } |
                  contract UnitContract(@"release", @slotIds, releaseToken, ret2) = {
                    unitReleaseSeq!(slotIds, 0, *releaseToken, *ret2)
                  } |
                  contract UnitContract(@"confirm", @slotIds, releaseToken, ret2) = {
                    unitConfirmSeq!(slotIds, 0, *releaseToken, *ret2)
                  } |
                  contract UnitContract(@"reset", dId2, @slotId, ret2) = {
                    new oCh2 in {
                      authIsOwner!(*dId2, providerId, *oCh2) |
                      for (@v <- oCh2) {
                        match v {
                          (true, Nil) => { unitSlotReset!(slotId, *ret2) }
                          _ => { ret2!(v) }
                        }
                      }
                    }
                  } |
                  contract UnitContract(@"adminPause", @nonce, @sigs, ret2) = {
                    for (@st <- unitState) {
                      if (nonce <= st.get("nonce")) {
                        unitState!(st) | ret2!((false, "replay"))
                      } else {
                        new vCh in {
                          adminGuard!("unit:" ++ unitId, nonce, "pause", [], sigs,
                                       st.get("admins"), st.get("threshold"), *vCh) |
                          for (@v <- vCh) {
                            match v {
                              (true, ok) => {
                                if (ok == false) {
                                  unitState!(st) | ret2!((false, "below threshold"))
                                } else {
                                  unitState!(st.set("status", "paused")
                                               .set("nonce", nonce)) |
                                  ret2!((true, Nil))
                                }
                              }
                              _ => { unitState!(st) | ret2!((false, "below threshold")) }
                            }
                          }
                        }
                      }
                    }
                  } |
                  contract UnitContract(@"setAdmins", @nonce, @newAdmins,
                                        @newThreshold, @sigs, ret2) = {
                    for (@st <- unitState) {
                      if (nonce <= st.get("nonce")) {
                        unitState!(st) | ret2!((false, "replay"))
                      } else {
                        new vCh in {
                          adminGuard!("unit:" ++ unitId, nonce, "setAdmins",
                                       [newAdmins, newThreshold], sigs,
                                       st.get("admins"), st.get("threshold"), *vCh) |
                          for (@v <- vCh) {
                            match v {
                              (true, ok) => {
                                if (ok == false) {
                                  unitState!(st) | ret2!((false, "below threshold"))
                                } else {
                                  if (newThreshold < 1
                                      || newThreshold > newAdmins.length()) {
                                    unitState!(st) | ret2!((false, "threshold"))
                                  } else {
                                    unitState!(st.set("admins", newAdmins)
                                                 .set("threshold", newThreshold)
                                                 .set("nonce", nonce)) |
                                    ret2!((true, Nil))
                                  }
                                }
                              }
                              _ => { unitState!(st) | ret2!((false, "below threshold")) }
                            }
                          }
                        }
                      }
                    }
                  } |

                  contract unitMakeSlots(@specs, @i, @acc, ret2) = {
                    if (i >= specs.length()) {
                      ret2!(acc)
                    } else {
                      match specs.nth(i) {
                        spec => {
                          match spec.get("slotId") {
                            slotId => {
                              new SlotContract, slotState, sCh in {
                                slotState!(["free", 0]) |
                                contract SlotContract(@"probe", ret3) = {
                                  for (@sl <<- slotState) {
                                    match sl {
                                      ["free", gen] => { ret3!((true, sl)) }
                                      ["held", bId, until, token] => {
                                        ret3!((true, ["held", bId, until]))
                                      }
                                      ["booked", bId, token] => {
                                        ret3!((true, ["booked", bId]))
                                      }
                                      _ => { ret3!((true, ["invalid"])) }
                                    }
                                  }
                                } |
                                contract SlotContract(@"hold", @bookingId, @untilHeight,
                                                      @now, releaseToken, ret3) = {
                                  for (@sl <- slotState) {
                                    match sl {
                                      ["free", gen] => {
                                        slotState!(["held", bookingId, untilHeight,
                                                    *releaseToken]) |
                                        ret3!((true, Nil))
                                      }
                                      ["held", oldId, oldUntil, oldToken] => {
                                        if (now >= oldUntil) {
                                          slotState!(["held", bookingId, untilHeight,
                                                      *releaseToken]) |
                                          ret3!((true, Nil))
                                        } else {
                                          slotState!(sl) |
                                          ret3!((false, "slot held", oldUntil))
                                        }
                                      }
                                      _ => {
                                        slotState!(sl) | ret3!((false, "slot held"))
                                      }
                                    }
                                  }
                                } |
                                contract SlotContract(@"release", releaseToken, ret3) = {
                                  for (@sl <- slotState) {
                                    match sl {
                                      ["free", gen] => {
                                        slotState!(sl) | ret3!((true, Nil))
                                      }
                                      ["held", bId, until, token] => {
                                        if (token == *releaseToken) {
                                          slotState!(["free", 0]) |
                                          ret3!((true, Nil))
                                        } else {
                                          slotState!(sl) |
                                          ret3!((false, "not holder"))
                                        }
                                      }
                                      ["booked", bId, token] => {
                                        if (token == *releaseToken) {
                                          slotState!(["free", 0]) |
                                          ret3!((true, Nil))
                                        } else {
                                          slotState!(sl) |
                                          ret3!((false, "not holder"))
                                        }
                                      }
                                      _ => {
                                        slotState!(sl) | ret3!((false, "not holder"))
                                      }
                                    }
                                  }
                                } |
                                contract SlotContract(@"confirm", releaseToken, ret3) = {
                                  for (@sl <- slotState) {
                                    match sl {
                                      ["held", bId, until, token] => {
                                        if (token == *releaseToken) {
                                          slotState!(["booked", bId, token]) |
                                          ret3!((true, Nil))
                                        } else {
                                          slotState!(sl) |
                                          ret3!((false, "not held"))
                                        }
                                      }
                                      _ => {
                                        slotState!(sl) | ret3!((false, "not held"))
                                      }
                                    }
                                  }
                                } |
                                contract SlotContract(@"reset", resetToken2, ret3) = {
                                  for (@sl <- slotState) {
                                    if (*resetToken2 == *resetToken) {
                                      match sl {
                                        ["free", gen] => {
                                          slotState!(sl) | ret3!((true, Nil))
                                        }
                                        _ => {
                                          slotState!(["free", 0]) |
                                          ret3!((true, Nil))
                                        }
                                      }
                                    } else {
                                      slotState!(sl) | ret3!((false, "not provider"))
                                    }
                                  }
                                } |
                                rs!(bundle+{*SlotContract}, *sCh) |
                                for (@uri <- sCh) {
                                  unitMakeSlots!(specs, i + 1,
                                                 acc.set(slotId, uri), *ret2)
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  } |

                  new slotsCh in {
                    unitMakeSlots!(slots, 0, {}, *slotsCh) |
                    for (@slotMap <- slotsCh) {
                      for (@st <- unitState) {
                        unitState!(st.set("slots", slotMap)) |
                        rs!(bundle+{*UnitContract}, *uCh) |
                        for (@uri <- uCh) { ret!((true, uri)) }
                      }
                    }
                  }
                }
              }
              }
            }
          }
          _ => { ret!(v) }
        }
      }
    }
  } |

  contract unitAllHold(@unitSlots, @i, @bookingId, @until, releaseToken, ret) = {
    if (i >= unitSlots.length()) {
      ret!((true, Nil))
    } else {
      match unitSlots.nth(i) {
        us => {
          new cCh in {
            rl!(us.get("unitUri"), *cCh) |
            for (Unit <- cCh) {
              new hCh in {
                Unit!("hold", bookingId, us.get("slots"), until,
                      *releaseToken, *hCh) |
                for (@h <- hCh) {
                  match h {
                    (true, Nil) => {
                      unitAllHold!(unitSlots, i + 1, bookingId, until,
                                   *releaseToken, *ret)
                    }
                    _ => {
                      new relCh in {
                        unitAllRelease!(unitSlots, 0, *releaseToken, *relCh) |
                        for (@_ <- relCh) { ret!(h) }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract unitAllRelease(@unitSlots, @i, releaseToken, ret) = {
    if (i >= unitSlots.length()) {
      ret!((true, Nil))
    } else {
      match unitSlots.nth(i) {
        us => {
          new cCh in {
            rl!(us.get("unitUri"), *cCh) |
            for (Unit <- cCh) {
              new rCh in {
                Unit!("release", us.get("slots"), *releaseToken, *rCh) |
                for (@_ <- rCh) {
                  unitAllRelease!(unitSlots, i + 1, *releaseToken, *ret)
                }
              }
            }
          }
        }
      }
    }
  } |

  contract unitAllConfirm(@unitSlots, @i, releaseToken, ret) = {
    if (i >= unitSlots.length()) {
      ret!((true, Nil))
    } else {
      match unitSlots.nth(i) {
        us => {
          new cCh in {
            rl!(us.get("unitUri"), *cCh) |
            for (Unit <- cCh) {
              new c2 in {
                Unit!("confirm", us.get("slots"), *releaseToken, *c2) |
                for (@r <- c2) {
                  match r {
                    (true, Nil) => {
                      unitAllConfirm!(unitSlots, i + 1, *releaseToken, *ret)
                    }
                    _ => {
                      new relCh in {
                        unitAllRelease!(unitSlots, 0, *releaseToken, *relCh) |
                        for (@_ <- relCh) { ret!((false, "slot lost")) }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract UnitFactory(@"holdAll", @unitSlots, @bookingId, @until,
                       releaseToken, ret) = {
    unitAllHold!(unitSlots, 0, bookingId, until, *releaseToken, *ret)
  } |
  contract UnitFactory(@"releaseAll", @unitSlots, releaseToken, ret) = {
    unitAllRelease!(unitSlots, 0, *releaseToken, *ret)
  } |
  contract UnitFactory(@"confirmAll", @unitSlots, releaseToken, ret) = {
    unitAllConfirm!(unitSlots, 0, *releaseToken, *ret)
  } |

  rl!(`__ROOT_URI__`, *rootCh) |
  for (Root <- rootCh) {
    rs!(bundle+{*UnitFactory}, *c) |
    for (@uri <- c) {
      Root!("register", "component:unit-factory", uri, 1, "unit", *deployerId, *ack) |
      for (@r <- ack) { deployId!([uri]) }
    }
  }
}
