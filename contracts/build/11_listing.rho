// ListingFactory: validates provider, terms and admins, then delegates the instance.
// Placeholders: __ROOT_URI__.
new
  ListingFactory,
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, c, ack
in {
  contract listingResolve(@key, ret) = {
    new rCh, Root, kCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", key, 1, *kCh) |
        for (@r <- kCh) {
          match r {
            (true, uri, _) => {
              new cCh in {
                rl!(uri, *cCh) |
                for (C <- cCh) { ret!((true, C)) }
              }
            }
            _ => { ret!((false, "unavailable", key)) }
          }
        }
      }
    }
  } |

  contract listingTermsValues(@kind, @terms, ret) = {
    ret!([kind,
          terms.get("assetId"), terms.get("pricePerSlot"), terms.get("deposit"),
          terms.get("minSlots"), terms.get("maxSlots"),
          terms.get("instantBook"), terms.get("contiguous"),
          terms.get("holdBlocks"), terms.get("depositReviewBlocks"),
          terms.get("disputeWindowBlocks"), terms.get("noShowBlocks"),
          terms.get("fullRefundBeforeBlocks"), terms.get("partialRefundBps"),
          terms.get("partialRefundBeforeBlocks"), terms.get("feeBps"),
          terms.get("maxLeadBlocks"), terms.get("maxSlotBlocks"),
          terms.get("maxUnits"), terms.get("eventTransferCutoffBlocks")])
  } |

  contract ListingFactory(@"create", dId, @providerUri, @listingId, @kind,
                          @terms, ret) = {
    new pCh, oCh, ownCh in {
      rl!(providerUri, *pCh) |
      for (ProviderContract <- pCh) {
        ProviderContract!("checkOwner", *dId, *oCh) |
        ProviderContract!("owner", *ownCh) |
        for (@v <- oCh; @own <- ownCh) {
          match v {
            (true, Nil) => {
              match own {
                (true, providerId) => {
                  new polCh, codecCh, admCh in {
                    listingResolve!("component:policy", *polCh) |
                    listingResolve!("component:codec", *codecCh) |
                    listingResolve!("component:admin", *admCh) |
                    for (@pr <- polCh; @cr <- codecCh; @ar <- admCh) {
                      match pr {
                        (true, Policy) => {
                          match cr {
                            (true, Codec) => {
                              match ar {
                                (true, ShareAdmin) => {
                                  new tc, tv, hc, ac in {
                                    @Policy!("termsOk", kind, terms, *tc) |
                                    listingTermsValues!(kind, terms, *tv) |
                                    @ShareAdmin!("keys", *ac) |
                                    for (@t <- tc; @values <- tv; @a <- ac) {
                                      match t {
                                        (true, Nil) => {
                                          @Codec!("hash", "rshare:terms:v1",
                                                  values, *hc) |
                                          for (@h <- hc; @(true, admins, threshold) <- a) {
                                            match h {
                                              (true, termsHash) => {
                                                new fCh in {
                                                  listingResolve!(
                                                    "component:listing-contract-factory",
                                                    *fCh) |
                                                  for (@f <- fCh) {
                                                    match f {
                                                      (true, Factory) => {
                                                        new lcCh in {
                                                          @Factory!("create",
                                                            *dId, providerId,
                                                            listingId, kind, terms,
                                                            termsHash, admins,
                                                            threshold, *lcCh) |
                                                          for (@lr <- lcCh) {
                                                            match lr {
                                                              (true, listingUri) => {
                                                                new rc in {
                                                                  ProviderContract!(
                                                                    "registerListing",
                                                                    *dId, listingId,
                                                                    listingUri, kind,
                                                                    termsHash, *rc) |
                                                                  for (@rr <- rc) {
                                                                    match rr {
                                                                      (true, Nil) => {
                                                                        ret!((true, listingUri))
                                                                      }
                                                                      _ => { 1/0 }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                              _ => { ret!(lr) }
                                                            }
                                                          }
                                                        }
                                                      }
                                                      _ => {
                                                        ret!((false,
                                                              "listing factory unavailable"))
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                              _ => { ret!((false, "codec")) }
                                            }
                                          }
                                        }
                                        _ => { ret!(t) }
                                      }
                                    }
                                  }
                                }
                                _ => { ret!(ar) }
                              }
                            }
                            _ => { ret!(cr) }
                          }
                        }
                        _ => { ret!(pr) }
                      }
                    }
                  }
                }
                _ => { ret!(own) }
              }
            }
            _ => { ret!(v) }
          }
        }
      }
    }
  } |

  rl!(`__ROOT_URI__`, *rootCh) |
  for (Root <- rootCh) {
    rs!(bundle+{*ListingFactory}, *c) |
    for (@uri <- c) {
      Root!("register", "component:listing-factory", uri, 1, "listing", *deployerId, *ack) |
      for (@r <- ack) { deployId!([uri]) }
    }
  }
}
