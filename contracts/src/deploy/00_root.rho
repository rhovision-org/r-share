// ShareRoot: the installer-gated component directory.
// Placeholders: __ADMINS__, __THRESHOLD__.
new
  ShareRoot, rootState,
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  dops(`rho:rchain:deployerId:ops`),
  deployId(`rho:rchain:deployId`),
  pkCh, uriCh, ack
in {
  // @@INLINE:lib/Guard.rho@@

  contract ShareRoot(@"resolve", @key, @minVersion, ret) = {
    for (@s <<- rootState) {
      match s.get("entries").get(key) {
        Nil => { ret!((false, "unknown component")) }
        e => {
          if (e.get("status") != "active") { ret!((false, "retired")) }
          else {
            if (e.get("version") < minVersion) { ret!((false, "stale")) }
            else { ret!((true, e.get("uri"), e.get("version"))) }
          }
        }
      }
    }
  } |

  contract ShareRoot(@"get", @key, ret) = {
    for (@s <<- rootState) {
      match s.get("entries").get(key) {
        Nil => { ret!((false, "unknown component")) }
        e => { ret!((true, e)) }
      }
    }
  } |

  contract ShareRoot(@"keys", ret) = {
    for (@s <<- rootState) {
      ret!((true, s.get("entries").keys()))
    }
  } |

  contract ShareRoot(@"register", @key, @uri, @version, @kind, dId, ret) = {
    for (@s <- rootState) {
      if (s.get("frozen")) {
        rootState!(s) | ret!((false, "frozen"))
      } else {
        new pkC in {
          dops!("pubKeyBytes", *dId, *pkC) |
          for (@pk <- pkC) {
            if (pk != s.get("installer")) {
              rootState!(s) | ret!((false, "not installer"))
            } else {
              if (version < 1) {
                rootState!(s) | ret!((false, "bad version"))
              } else {
                match s.get("entries").get(key) {
                  Nil => {
                    match s.get("entries").set(key, {
                      "uri": uri, "version": version, "kind": kind, "status": "active"
                    }) {
                      entries => {
                        rootState!(s.set("entries", entries)) |
                        ret!((true, Nil))
                      }
                    }
                  }
                  _ => { rootState!(s) | ret!((false, "duplicate")) }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract ShareRoot(@"rotate", @key, @expectedVersion, @newUri, @newVersion,
                     @nonce, @sigs, ret) = {
    for (@s <- rootState) {
      if (nonce <= s.get("govNonce")) {
        rootState!(s) | ret!((false, "replay"))
      } else {
        new vCh in {
          verifyAdmin!("root", nonce, "rotate",
                       [key, expectedVersion, newUri, newVersion],
                       sigs, s.get("admins"), s.get("threshold"), *vCh) |
          for (@v <- vCh) {
            match v {
              (true, ok) => {
                if (ok == false) {
                  rootState!(s) | ret!((false, "below threshold"))
                } else {
                  match s.get("entries").get(key) {
                    Nil => { rootState!(s) | ret!((false, "unknown component")) }
                    e => {
                      if (e.get("version") != expectedVersion) {
                        rootState!(s) | ret!((false, "stale"))
                      } else {
                        match e.set("uri", newUri).set("version", newVersion) {
                          e2 => {
                            match s.set("entries", s.get("entries").set(key, e2))
                                    .set("govNonce", nonce) {
                              s2 => { rootState!(s2) | ret!((true, Nil)) }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
              _ => { rootState!(s) | ret!((false, "below threshold")) }
            }
          }
        }
      }
    }
  } |

  contract ShareRoot(@"deprecate", @key, @nonce, @sigs, ret) = {
    for (@s <- rootState) {
      if (nonce <= s.get("govNonce")) {
        rootState!(s) | ret!((false, "replay"))
      } else {
        new vCh in {
          verifyAdmin!("root", nonce, "deprecate", [key], sigs,
                       s.get("admins"), s.get("threshold"), *vCh) |
          for (@v <- vCh) {
            match v {
              (true, ok) => {
                if (ok == false) {
                  rootState!(s) | ret!((false, "below threshold"))
                } else {
                  match s.get("entries").get(key) {
                    Nil => { rootState!(s) | ret!((false, "unknown component")) }
                    e => {
                      match s.set("entries",
                                   s.get("entries").set(key, e.set("status", "retired")))
                              .set("govNonce", nonce) {
                        s2 => { rootState!(s2) | ret!((true, Nil)) }
                      }
                    }
                  }
                }
              }
              _ => { rootState!(s) | ret!((false, "below threshold")) }
            }
          }
        }
      }
    }
  } |

  contract ShareRoot(@"freeze", @nonce, @sigs, ret) = {
    for (@s <- rootState) {
      if (nonce <= s.get("govNonce")) {
        rootState!(s) | ret!((false, "replay"))
      } else {
        new vCh in {
          verifyAdmin!("root", nonce, "freeze", [], sigs,
                       s.get("admins"), s.get("threshold"), *vCh) |
          for (@v <- vCh) {
            match v {
              (true, ok) => {
                if (ok == false) {
                  rootState!(s) | ret!((false, "below threshold"))
                } else {
                  rootState!(s.set("frozen", true).set("govNonce", nonce)) |
                  ret!((true, Nil))
                }
              }
              _ => { rootState!(s) | ret!((false, "below threshold")) }
            }
          }
        }
      }
    }
  } |

  contract ShareRoot(@"admin", @nonce, @action, @args, @sigs, ret) = {
    for (@s <- rootState) {
      if (nonce <= s.get("govNonce")) {
        rootState!(s) | ret!((false, "replay"))
      } else {
        new vCh in {
          verifyAdmin!("root", nonce, action, args, sigs,
                       s.get("admins"), s.get("threshold"), *vCh) |
          for (@v <- vCh) {
            match v {
              (true, ok) => {
                if (ok == false) {
                  rootState!(s) | ret!((false, "below threshold"))
                } else {
                  match action {
                    "setAdmins" => {
                      match args.nth(0) {
                        newAdmins => {
                          match args.nth(1) {
                            newThreshold => {
                              if (newThreshold < 1 || newThreshold > newAdmins.length()) {
                                rootState!(s) | ret!((false, "threshold"))
                              } else {
                                rootState!(s.set("admins", newAdmins)
                                            .set("threshold", newThreshold)
                                            .set("govNonce", nonce)) |
                                ret!((true, Nil))
                              }
                            }
                          }
                        }
                      }
                    }
                    "setThreshold" => {
                      match args.nth(0) {
                        newThreshold => {
                          if (newThreshold < 1 || newThreshold > s.get("admins").length()) {
                            rootState!(s) | ret!((false, "threshold"))
                          } else {
                            rootState!(s.set("threshold", newThreshold)
                                        .set("govNonce", nonce)) |
                            ret!((true, Nil))
                          }
                        }
                      }
                    }
                    _ => { rootState!(s) | ret!((false, "unknown action")) }
                  }
                }
              }
              _ => { rootState!(s) | ret!((false, "below threshold")) }
            }
          }
        }
      }
    }
  } |

  dops!("pubKeyBytes", *deployerId, *pkCh) |
  for (@installer <- pkCh) {
    rootState!({
      "installer": installer,
      "admins": __ADMINS__,
      "threshold": __THRESHOLD__,
      "frozen": false,
      "govNonce": 0,
      "entries": {}
    }) |
    rs!(bundle+{*ShareRoot}, *uriCh) |
    for (@uri <- uriCh) {
      ShareRoot!("register", "component:root", uri, 1, "kernel", *deployerId, *ack) |
      for (@r <- ack) {
        match r {
          (true, Nil) => { deployId!([uri]) }
          _ => { deployId!([("root register failed", r)]) }
        }
      }
    }
  }
}
