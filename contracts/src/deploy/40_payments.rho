// Payments: the r-cash adapter. Every arm resolves the r-cash Root at entry.
// Placeholders: __ROOT_URI__, __RCASH_ROOT_URI__, __PLATFORM_OWNER__.
new
  Payments, paymentsState,
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  dops(`rho:rchain:deployerId:ops`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, c, ack,
  adminGuard, payResolveUri, payShareResolve,
  resolveComponent
in {
  // @@INLINE:lib/Resolve.rho@@

  // @@INLINE:lib/AdminGuard.rho@@


  contract payResolveUri(@key, ret) = {
    for (@s <<- paymentsState) {
      new rCh, Root, kCh in {
        rl!(s.get("rcashRootUri"), *rCh) |
        for (Root <- rCh) {
          Root!("resolve", key, s.get("minVersion"), *kCh) |
          for (@r <- kCh) {
            match r {
              (true, uri, version) => { ret!((true, uri, version)) }
              _ => { ret!((false, "rcash unavailable", key)) }
            }
          }
        }
      }
    }
  } |

  contract payShareResolve(@key, ret) = {
    resolveComponent!(key, *ret)
  } |

  contract Payments(@"health", ret) = {
    new afCh, arCh, clkCh in {
      payResolveUri!("component:account-factory", *afCh) |
      payResolveUri!("component:asset-resolver", *arCh) |
      payResolveUri!("component:clock", *clkCh) |
      for (@a <- afCh; @b <- arCh; @c <- clkCh) {
        match a {
          (true, _, av) => {
            match b {
              (true, _, bv) => {
                match c {
                  (true, _, cv) => {
                    ret!((true, {"accountFactory": av, "assetResolver": bv, "clock": cv}))
                  }
                  _ => { ret!(c) }
                }
              }
              _ => { ret!(b) }
            }
          }
          _ => { ret!(a) }
        }
      }
    }
  } |

  contract Payments(@"ensureAccount", dId, ret) = {
    new uCh in {
      payResolveUri!("component:account-factory", *uCh) |
      for (@u <- uCh) {
        match u {
          (true, uri, _) => {
            new cCh, pkCh in {
              rl!(uri, *cCh) |
              dops!("pubKeyBytes", *dId, *pkCh) |
              for (AccountFactory <- cCh; @pk <- pkCh) {
                AccountFactory!("getOrCreate", pk, *ret)
              }
            }
          }
          _ => { ret!(u) }
        }
      }
    }
  } |

  contract Payments(@"accountOf", @ownerId, ret) = {
    new uCh in {
      payResolveUri!("component:account-factory", *uCh) |
      for (@u <- uCh) {
        match u {
          (true, uri, _) => {
            new cCh in {
              rl!(uri, *cCh) |
              for (AccountFactory <- cCh) {
                AccountFactory!("accountOf", ownerId, *ret)
              }
            }
          }
          _ => { ret!(u) }
        }
      }
    }
  } |

  contract Payments(@"depositFacet", @ownerId, @assetId, ret) = {
    new aCh in {
      Payments!("accountOf", ownerId, *aCh) |
      for (@a <- aCh) {
        match a {
          (true, account) => { @account!("depositFacet", assetId, *ret) }
          _ => { ret!(a) }
        }
      }
    }
  } |

  contract Payments(@"issuer", @assetId, ret) = {
    new uCh in {
      payResolveUri!("component:asset-resolver", *uCh) |
      for (@u <- uCh) {
        match u {
          (true, uri, _) => {
            new cCh in {
              rl!(uri, *cCh) |
              for (AssetResolver <- cCh) {
                AssetResolver!("issuer", assetId, *ret)
              }
            }
          }
          _ => { ret!(u) }
        }
      }
    }
  } |

  contract Payments(@"platformOwner", ret) = {
    for (@s <<- paymentsState) { ret!((true, s.get("platformOwnerId"))) }
  } |

  contract Payments(@"admin", @nonce, @action, @args, @sigs, ret) = {
    for (@s <- paymentsState) {
      if (nonce <= s.get("nonce")) {
        paymentsState!(s) | ret!((false, "replay"))
      } else {
        new uCh in {
          payShareResolve!("component:admin", *uCh) |
          for (@u <- uCh) {
            match u {
              (true, ShareAdmin) => {
                new kCh in {
                  @ShareAdmin!("keys", *kCh) |
                    for (@k <- kCh) {
                      match k {
                        (true, admins, threshold) => {
                          new vCh in {
                            adminGuard!("payments", nonce, action, args, sigs,
                                         admins, threshold, *vCh) |
                            for (@v <- vCh) {
                              match v {
                                (true, ok) => {
                                  if (ok == false) {
                                    paymentsState!(s) | ret!((false, "below threshold"))
                                  } else {
                                    match action {
                                      "setPlatformOwner" => {
                                        match args.nth(0) {
                                          ownerId => {
                                            paymentsState!(s.set("platformOwnerId", ownerId)
                                                            .set("nonce", nonce)) |
                                            ret!((true, Nil))
                                          }
                                        }
                                      }
                                      "setAssets" => {
                                        match args.nth(0) {
                                          assets => {
                                            paymentsState!(s.set("assets", assets)
                                                            .set("nonce", nonce)) |
                                            ret!((true, Nil))
                                          }
                                        }
                                      }
                                      "setRcashRoot" => {
                                        match args.nth(0) {
                                          newRoot => {
                                            paymentsState!(s.set("rcashRootUri", newRoot)
                                                            .set("nonce", nonce)) |
                                            ret!((true, Nil))
                                          }
                                        }
                                      }
                                      _ => {
                                        paymentsState!(s) | ret!((false, "unknown action"))
                                      }
                                    }
                                  }
                                }
                                _ => {
                                  paymentsState!(s) | ret!((false, "below threshold"))
                                }
                              }
                            }
                          }
                        }
                        _ => { paymentsState!(s) | ret!((false, "admin unavailable")) }
                      }
                    }
                }
              }
              _ => { paymentsState!(s) | ret!((false, "rcash unavailable", "component:admin")) }
            }
          }
        }
      }
    }
  } |

  paymentsState!({
    "rcashRootUri": "__RCASH_ROOT_URI__",
    "minVersion": 1,
    "platformOwnerId": "__PLATFORM_OWNER__",
    "assets": ["REV"],
    "nonce": 0
  }) |

  rl!(`__ROOT_URI__`, *rootCh) |
  for (Root <- rootCh) {
    rs!(bundle+{*Payments}, *c) |
    for (@uri <- c) {
      Root!("register", "component:payments", uri, 1, "payments", *deployerId, *ack) |
      for (@r <- ack) { deployId!([uri]) }
    }
  }
}
